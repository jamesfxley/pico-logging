# AR-1: a no-exceptions log statement must not reach a throwing substring path.
file(GLOB_RECURSE objects "${OBJECT_ROOT}/*.o" "${OBJECT_ROOT}/*.obj")
if(NOT objects)
    message(FATAL_ERROR "no probe objects at ${OBJECT_ROOT}")
endif()
if(DEFINED DEBUG_ROOT)
    file(GLOB_RECURSE debug_objects "${DEBUG_ROOT}/*.o" "${DEBUG_ROOT}/*.obj")
    if(NOT debug_objects)
        message(FATAL_ERROR "no debug objects at ${DEBUG_ROOT}")
    endif()
    list(APPEND objects ${debug_objects})
endif()
foreach(object IN LISTS objects)
    execute_process(COMMAND "${NM}" -u "${object}"
        RESULT_VARIABLE status OUTPUT_VARIABLE symbols ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "nm refused ${object}: ${error}")
    endif()
    if(symbols MATCHES "__throw_out_of_range_fmt")
        message(FATAL_ERROR "throwing substring path in ${object}")
    endif()
endforeach()
